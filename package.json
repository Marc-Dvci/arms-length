{
  "name": "arms-length",
  "version": "1.0.0",
  "description": "Independent approval for agent-written code: a Forge app for Jira, Bitbucket, Confluence and Rovo.",
  "license": "MIT",
  "private": true,
  "author": "Marc Donovici",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "pretest": "node scripts/check-shell.mjs",
    "audit": "npm run typecheck && npm test && npm run eval && npm run manifest && npm run demo",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "demo": "tsx cli/demo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "forge lint",
    "manifest": "node scripts/validate-manifests.cjs",
    "release-gate": "tsx scripts/release-gate.ts"
  },
  "devDependencies": {
    "@forge/manifest": "^13.8.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@forge/api": "^8.4.0",
    "@forge/bridge": "^7.2.1",
    "@forge/kvs": "^2.1.1",
    "@forge/react": "^12.4.0",
    "@forge/resolver": "^2.0.2",
    "react": "^18.3.1"
  },
  "overrides": {
    "prosemirror-view": "^1.42.3",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
